+/* iOS 27 terminates apps that don't adopt the UIScene lifecycle, and a window
+ * must be created against a UIWindowScene under it. The scene connects
+ * asynchronously after didFinishLaunching, which can be AFTER SDL_main has
+ * started (SDL runs it from a performSelector:afterDelay:0), so pump the run
+ * loop until one shows up. Returns nil on timeout, in which case the caller
+ * falls back to the legacy scene-less UIWindow. */
+static UIWindowScene *UIKit_WaitForWindowScene(void)
+{
+    const CFAbsoluteTime deadline = CFAbsoluteTimeGetCurrent() + 5.0;
+    for (;;) {
+        for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+            if ([scene isKindOfClass:[UIWindowScene class]]) {
+                return (UIWindowScene *)scene;
+            }
+        }
+        if (CFAbsoluteTimeGetCurrent() >= deadline) {
+            return nil;
+        }
+        CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+    }
+}
