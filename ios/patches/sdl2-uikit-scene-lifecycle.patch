+/* Scene delegate for the UIScene lifecycle (required by iOS 27). Named by
+ * UISceneDelegateClassName in Info.plist's UIApplicationSceneManifest. It lives
+ * in this file so the static-library linker always pulls it in alongside
+ * SDLUIKitDelegate. Windows are attached to the scene in SDL_uikitwindow.m;
+ * app lifecycle still reaches SDL through the UIApplication notifications,
+ * which UIKit keeps posting for scene-based apps. What changes is URL
+ * delivery: application:openURL:options: is no longer called, so documents
+ * opened via "Open in..." arrive here instead. */
+@interface SDLUIKitSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@end
+
+@implementation SDLUIKitSceneDelegate
+
+- (void)forwardURLContexts:(NSSet<UIOpenURLContext *> *)contexts
+{
+    for (UIOpenURLContext *context in contexts) {
+        [[SDLUIKitDelegate sharedAppDelegate] sendDropFileForURL:context.URL];
+    }
+}
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    /* A document that launched the app. */
+    [self forwardURLContexts:connectionOptions.URLContexts];
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+    [self forwardURLContexts:URLContexts];
+}
+
+@end
+
